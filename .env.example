# ─── APP ───────────────────────────────────────
APP_ENV = stage

# ─── AUTH APP ───────────────────────────────────────
AUTH_SERVICE_JWT__SECRET=local-dev-secret-change-me

AUTH_MYSQL_HOST=mini_wallet-db
AUTH_MYSQL_USERNAME=wallet_admin
AUTH_MYSQL_PASSWORD=wallet_pass

AUTH_PUBLISHER_URL=amqp://guest:guest@mini_wallet-rabbitmq:5672

# ─── NOTIFICATION APP ──────────────────────────────────────────
NOTIFICATION_JWT__SECRET=local-dev-secret-change-me

NOTIFICATION_REDIS_PASSWORD=redis_stage_password_2024
NOTIFICATION_REDIS_DB=0

NOTIFICATION_SUBSCRIBER_URL=amqp://guest:guest@mini_wallet-rabbitmq:5672

NOTIFICATION_ONE__SIGNAL_APP__ID=
NOTIFICATION_ONE__SIGNAL_API__KEY=

NOTIFICATION_MYSQL_HOST=mini_wallet-db
NOTIFICATION_MYSQL_USERNAME=wallet_admin
NOTIFICATION_MYSQL_PASSWORD=wallet_pass

# ─── WALLET APP ─────────────────────────────────────────
WALLET_MYSQL_HOST=mini_wallet-db
WALLET_MYSQL_USERNAME=wallet_admin
WALLET_MYSQL_PASSWORD=wallet_pass

WALLET_SUBSCRIBER_URL=amqp://guest:guest@mini_wallet-rabbitmq:5672

# ─── GRAFANA ───────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SMTP_ENABLED=true
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM_ADDRESS=
GRAFANA_SMTP_FROM_NAME=mini-wallet
GRAFANA_UNIFIED_ALERTING_ENABLED=true